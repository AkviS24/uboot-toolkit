# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.pyre/
.ruff_cache/


# ------------------------------------------------------------
# IDE / Editor
# ------------------------------------------------------------

.vscode/
.idea/

# Local editor files
*.swp
*.swo
*~
.DS_Store


# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

# Local configuration
config.local.*
settings.local.*


